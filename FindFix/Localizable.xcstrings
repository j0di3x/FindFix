          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui código adaptado do Vorssaint, © 2026 Vorssaint. O FindFix é um projeto não oficial, sem afiliação nem endosso do Vorssaint."
