            "state": "translated",
            "value": "Aktualizácie"
          }
        }
      }
    },
    "Use when FindFix is switched on in System Settings but still shows Needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذا عندما يكون FindFix مفعّلًا في إعدادات النظام ولكنه لا يزال يعرض «مطلوب»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংসে FindFix চালু থাকলেও “প্রয়োজন” দেখালে এটি ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende dies, wenn FindFix in den Systemeinstellungen aktiviert ist, aber weiterhin „Erforderlich“ anzeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo si FindFix está activado en Ajustes del Sistema pero sigue mostrando “Necesario”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À utiliser si FindFix est activé dans Réglages Système mais affiche toujours « Requis »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब सिस्टम सेटिंग्ज़ में FindFix चालू हो, फिर भी “ज़रूरी” दिखे, तब इसका उपयोग करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkor használd, ha a FindFix be van kapcsolva a Rendszerbeállításokban, de továbbra is a „Szükséges” látszik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan saat FindFix aktif di Pengaturan Sistem tetapi masih menampilkan “Diperlukan”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use quando o FindFix estiver ativado em Ajustes do Sistema, mas ainda mostrar “Necessário”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте, если FindFix включён в Системных настройках, но всё ещё показано «Требуется»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite, keď je FindFix zapnutý v Systémových nastaveniach, ale stále sa zobrazuje „Potrebné“."
          }
        }
      }
    },
