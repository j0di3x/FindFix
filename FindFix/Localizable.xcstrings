    "Waiting for Accessibility permission.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار إذن تسهيلات الاستخدام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাক্সেসিবিলিটি অনুমতির জন্য অপেক্ষা করা হচ্ছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf die Berechtigung für Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando el permiso de Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de l’autorisation Accessibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐक्सेसिबिलिटी अनुमति की प्रतीक्षा है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várakozás a Kisegítő lehetőségek engedélyére."
          }
        },
        "id": {
          "stringUnit": {
