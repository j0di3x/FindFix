    "Includes code adapted from Vorssaint, © 2026 Vorssaint. FindFix is an unofficial project, not affiliated with or endorsed by Vorssaint.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن شيفرة مقتبسة من Vorssaint، © 2026 Vorssaint. FindFix مشروع غير رسمي، وليس تابعًا لـ Vorssaint ولا معتمدًا منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorssaint থেকে অভিযোজিত কোড অন্তর্ভুক্ত, © 2026 Vorssaint। FindFix একটি অনানুষ্ঠানিক প্রকল্প, Vorssaint-এর সাথে সম্পর্কিত বা তার দ্বারা অনুমোদিত নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Code, der von Vorssaint übernommen wurde, © 2026 Vorssaint. FindFix ist ein inoffizielles Projekt und steht in keiner Verbindung zu Vorssaint und wird nicht von Vorssaint unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye código adaptado de Vorssaint, © 2026 Vorssaint. FindFix es un proyecto no oficial, sin afiliación ni respaldo de Vorssaint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut du code adapté de Vorssaint, © 2026 Vorssaint. FindFix est un projet non officiel, ni affilié à Vorssaint ni approuvé par lui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें Vorssaint से अनुकूलित कोड शामिल है, © 2026 Vorssaint। FindFix एक अनौपचारिक प्रोजेक्ट है, जो Vorssaint से संबद्ध या उसके द्वारा समर्थित नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vorssaintból átvett kódot tartalmaz, © 2026 Vorssaint. A FindFix nem hivatalos projekt, nem áll kapcsolatban a Vorssainttal, és az nem támogatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
