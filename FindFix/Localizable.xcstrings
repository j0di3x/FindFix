    "Version %@ is the newest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار %@ هو الأحدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ %@ সর্বশেষ।"
          }
        },
