    "Allow FindFix under System Settings › General › Login Items.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ FindFix في إعدادات النظام › عام › عناصر تسجيل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস › সাধারণ › লগইন আইটেম-এ FindFix-কে অনুমতি দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube FindFix unter Systemeinstellungen › Allgemein › Anmeldeobjekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite FindFix en Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez FindFix dans Réglages Système › Général › Ouverture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ › सामान्य › लॉगिन आइटम में FindFix को अनुमति दें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a FindFixet a Rendszerbeállítások › Általános › Bejelentkezési elemek alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan FindFix di Pengaturan Sistem › Umum › Item Masuk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o FindFix em Ajustes do Sistema › Geral › Itens de Início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите FindFix в разделе «Системные настройки» › «Основные» › «Объекты входа»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte FindFix v Systémových nastaveniach › Všeobecné › Položky pri prihlásení."
          }
        }
      }
    },
    "Asks for confirmation every time. Can’t be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب التأكيد في كل مرة. لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিবার নিশ্চিতকরণ চায়। পূর্বাবস্থায় ফেরানো যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt jedes Mal nach. Kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide confirmación cada vez. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande une confirmation à chaque fois. Action irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बार पुष्टि माँगता है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden alkalommal megerősítést kér. Nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta konfirmasi setiap kali. Tidak dapat dibatalkan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede confirmação toda vez. Não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз запрашивает подтверждение. Отменить нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakaždým si vyžiada potvrdenie. Nedá sa vrátiť späť."
          }
        }
      }
    },
