            "state": "translated",
            "value": "Ожидание разрешения «Универсальный доступ»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čaká sa na povolenie Prístupnosti."
          }
        }
      }
    },
    "You can download FindFix %@ and install it yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تنزيل FindFix %@ وتثبيته بنفسك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি FindFix %@ ডাউনলোড করে নিজেই ইনস্টল করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst FindFix %@ laden und selbst installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes descargar FindFix %@ e instalarlo tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez télécharger FindFix %@ et l’installer vous-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप FindFix %@ डाउनलोड करके ख़ुद इंस्टॉल कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Letöltheted a FindFix %@ verziót, és magad is telepítheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengunduh FindFix %@ dan menginstalnya sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode baixar o FindFix %@ e instalá-lo manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете загрузить FindFix %@ и установить его самостоятельно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "FindFix %@ si môžete stiahnuť a nainštalovať sami."
          }
        }
      }
    },
    "You have %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
