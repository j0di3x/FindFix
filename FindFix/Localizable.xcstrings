        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাউনলোড করা অ্যাপটি কোড সিগনেচার যাচাইয়ে ব্যর্থ হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Codesignatur der geladenen App ist ungültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app descargada no ha superado la comprobación de la firma de código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app téléchargée n’a pas passé la vérification de signature du code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड किया गया ऐप कोड सिग्नेचर जाँच में विफल रहा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltött app nem felelt meg a kódaláírás-ellenőrzésen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang diunduh gagal dalam pemeriksaan tanda tangan kode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app baixado não passou na verificação de assinatura de código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженное приложение не прошло проверку подписи кода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahnutá aplikácia neprešla kontrolou podpisu kódu."
          }
        }
      }
    },
    "The green button fills the desktop area instead of entering full screen. Click again to restore. ⌥-click keeps the macOS behavior.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يملأ الزر الأخضر مساحة سطح المكتب بدلًا من الدخول في وضع ملء الشاشة. انقر مرة أخرى للاستعادة. يحافظ النقر مع ⌥ على سلوك macOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবুজ বোতাম ফুল স্ক্রিনে না গিয়ে ডেস্কটপের জায়গা ভরে দেয়। ফিরিয়ে আনতে আবার ক্লিক করুন। ⌥-ক্লিক macOS-এর আচরণ বজায় রাখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der grüne Knopf füllt den Schreibtischbereich, statt den Vollbildmodus zu öffnen. Erneut klicken stellt das Fenster wieder her. ⌥-Klick behält das macOS-Verhalten bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón verde ocupa el área del escritorio en lugar de entrar en pantalla completa. Haz clic de nuevo para restaurar. ⌥-clic mantiene el comportamiento de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton vert remplit la zone du bureau au lieu de passer en plein écran. Cliquez à nouveau pour restaurer. ⌥-clic conserve le comportement de macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हरा बटन फ़ुल स्क्रीन में जाने के बजाय डेस्कटॉप क्षेत्र को भर देता है। वापस लाने के लिए फिर से क्लिक करें। ⌥-क्लिक macOS का व्यवहार बनाए रखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zöld gomb kitölti az asztal területét a teljes képernyő helyett. Újabb kattintással visszaáll. A ⌥-kattintás megtartja a macOS működését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol hijau mengisi area desktop alih-alih masuk ke layar penuh. Klik lagi untuk memulihkan. ⌥-klik mempertahankan perilaku macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão verde preenche a área da mesa em vez de entrar em tela cheia. Clique novamente para restaurar. ⌥-clique mantém o comportamento do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зелёная кнопка заполняет рабочую область вместо перехода в полноэкранный режим. Нажмите ещё раз, чтобы вернуть размер. ⌥-нажатие сохраняет поведение macOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelené tlačidlo vyplní plochu namiesto prechodu na celú obrazovku. Ďalším kliknutím sa okno obnoví. ⌥-kliknutie zachová správanie macOS."
          }
        }
      }
    },
    "The new version couldn’t replace the old one: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر استبدال الإصدار القديم بالإصدار الجديد: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন সংস্করণ পুরোনোটির জায়গা নিতে পারেনি: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Version konnte die alte nicht ersetzen: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nueva versión no ha podido reemplazar a la anterior: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle version n’a pas pu remplacer l’ancienne : %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया संस्करण पुराने की जगह नहीं ले सका: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új verzió nem tudta lecserélni a régit: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi baru tidak dapat menggantikan versi lama: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova versão não pôde substituir a antiga: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая версия не смогла заменить старую: %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová verzia nemohla nahradiť starú: %@"
          }
        }
      }
    },
    "The red close button quits the app when its last window closes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي زر الإغلاق الأحمر التطبيق عند إغلاق آخر نافذة له."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ উইন্ডো বন্ধ হলে লাল বন্ধ বোতাম অ্যাপটি প্রস্থান করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der rote Schließen-Knopf beendet die App, wenn ihr letztes Fenster geschlossen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón rojo de cierre sale de la app al cerrarse su última ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton rouge quitte l’app lorsque sa dernière fenêtre se ferme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आख़िरी विंडो बंद होने पर लाल बटन ऐप को बंद कर देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A piros bezárás gomb kilép az appból, amikor az utolsó ablaka bezárul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol tutup merah keluar dari app saat jendela terakhirnya ditutup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão vermelho encerra o app quando sua última janela é fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красная кнопка завершает приложение при закрытии его последнего окна."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Červené tlačidlo ukončí aplikáciu, keď sa zatvorí jej posledné okno."
          }
        }
      }
    },
    "This can’t be undone. The items will not go to the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا الإجراء. لن تنتقل العناصر إلى سلة المهملات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি পূর্বাবস্থায় ফেরানো যাবে না। আইটেমগুলো ট্র্যাশে যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht widerrufen werden. Die Objekte werden nicht in den Papierkorb gelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Los ítems no irán a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Les éléments n’iront pas dans la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पूर्ववत नहीं किया जा सकता। आइटम ट्रैश में नहीं जाएँगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem vonható vissza. Az elemek nem kerülnek a Kukába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak dapat dibatalkan. Item tidak akan masuk ke Tong Sampah."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível desfazer. Os itens não irão para a Lixeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие нельзя отменить. Объекты не попадут в Корзину."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto akciu nemožno vrátiť späť. Položky sa nepresunú do Koša."
          }
        }
      }
    },
    "Turning this off restores every stock macOS behavior at once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي إيقاف هذا الخيار إلى استعادة جميع سلوكيات macOS الأصلية فورًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বন্ধ করলে macOS-এর সব আসল আচরণ সঙ্গে সঙ্গে ফিরে আসে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ausschalten kehrt sofort das normale macOS-Verhalten zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivarlo se restablece al instante el comportamiento original de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La désactivation rétablit aussitôt tous les comportements d’origine de macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बंद करने पर macOS का मूल व्यवहार तुरंत लौट आता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolásával azonnal visszaáll a macOS eredeti működése."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mematikan ini langsung memulihkan semua perilaku bawaan macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar isto restaura de imediato o comportamento original do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключение сразу вернёт стандартное поведение macOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnutím sa okamžite obnoví pôvodné správanie macOS."
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحديثات"
          }
        },
        "bn": {
