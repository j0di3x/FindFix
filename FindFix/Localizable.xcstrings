          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la version %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास %@ है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te verziód: %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi Anda %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem a %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас версия %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte verziu %@."
          }
        }
      }
    },
    "Your shortcut starts renaming the selected item.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ الاختصار الخاص بك إعادة تسمية العنصر المحدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার শর্টকাট নির্বাচিত আইটেমের নাম বদল শুরু করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kurzbefehl startet das Umbenennen des ausgewählten Objekts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu atajo empieza a renombrar el ítem seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre raccourci lance le renommage de l’élément sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका शॉर्टकट चुने गए आइटम का नाम बदलना शुरू करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A billentyűparancs elindítja a kijelölt elem átnevezését."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan Anda memulai penggantian nama item yang dipilih."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu atalho começa a renomear o item selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сочетание клавиш запускает переименование выбранного объекта."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša skratka spustí premenovanie vybranej položky."
          }
        }
      }
    },
    "⌘X then ⌘V moves files. Copying something else cancels the cut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X ثم ⌘V ينقل الملفات. يؤدي نسخ شيء آخر إلى إلغاء القص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X তারপর ⌘V ফাইল সরায়। অন্য কিছু কপি করলে কাট বাতিল হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X und dann ⌘V bewegt Dateien. Wird etwas anderes kopiert, ist das Ausschneiden aufgehoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X y luego ⌘V mueve archivos. Copiar otra cosa cancela el corte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X puis ⌘V déplace les fichiers. Copier autre chose annule la coupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X फिर ⌘V से फ़ाइलें ले जाई जाती हैं। कुछ और कॉपी करने पर कट रद्द हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A ⌘X, majd a ⌘V áthelyezi a fájlokat. Ha mást másolsz, a kivágás megszakad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X lalu ⌘V memindahkan file. Menyalin hal lain membatalkan pemotongan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X e depois ⌘V move arquivos. Copiar outra coisa cancela o recorte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X, затем ⌘V перемещает файлы. Копирование другого объекта отменяет вырезание."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘X a potom ⌘V presúva súbory. Skopírovaním niečoho iného sa vystrihnutie zruší."
          }
        }
      }
    },
    "⌦ (fn+⌫ on Mac keyboards) moves selected items to the Trash. Text fields keep the key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ في لوحات مفاتيح Mac) ينقل العناصر المحددة إلى سلة المهملات. تحتفظ حقول النص بالمفتاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (Mac কীবোর্ডে fn+⌫) নির্বাচিত আইটেম ট্র্যাশে সরায়। টেক্সট ফিল্ডে কী স্বাভাবিকভাবে কাজ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ auf Mac-Tastaturen) legt ausgewählte Objekte in den Papierkorb. In Textfeldern bleibt die Taste unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ en teclados Mac) mueve los ítems seleccionados a la Papelera. Los campos de texto conservan la tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ sur les claviers Mac) place les éléments sélectionnés dans la Corbeille. Les champs de texte conservent la touche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (Mac कीबोर्ड पर fn+⌫) चुने गए आइटम को ट्रैश में ले जाता है। टेक्स्ट फ़ील्ड में कुंजी सामान्य रूप से काम करती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A ⌦ (Mac-billentyűzeten fn+⌫) a Kukába helyezi a kijelölt elemeket. A szövegmezőkben a billentyű a szokásos módon működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ di keyboard Mac) memindahkan item yang dipilih ke Tong Sampah. Bidang teks tetap memakai tombol ini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ em teclados Mac) move os itens selecionados para a Lixeira. Campos de texto mantêm a tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ на клавиатурах Mac) перемещает выбранные объекты в Корзину. В текстовых полях клавиша работает как обычно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "⌦ (fn+⌫ na klávesniciach Mac) presunie vybrané položky do Koša. V textových poliach kláves funguje ako obvykle."
          }
        }
      }
    }
  },
  "version": "1.0"
}