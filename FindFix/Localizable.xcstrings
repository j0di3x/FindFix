    "Free software under the GNU GPL v3 or later. It comes with ABSOLUTELY NO WARRANTY; you may redistribute it under the license’s conditions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج حر بموجب رخصة GNU GPL الإصدار 3 أو أحدث. يأتي دون أي ضمان على الإطلاق، ويمكنك إعادة توزيعه وفق شروط الرخصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU GPL v3 বা পরবর্তী সংস্করণের অধীনে মুক্ত সফটওয়্যার। এটি কোনো ওয়ারেন্টি ছাড়াই আসে; লাইসেন্সের শর্ত মেনে আপনি এটি পুনর্বিতরণ করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freie Software unter der GNU GPL v3 oder neuer. Sie wird OHNE JEGLICHE GEWÄHRLEISTUNG bereitgestellt; du darfst sie unter den Bedingungen der Lizenz weitergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Software libre bajo la GNU GPL v3 o posterior. Se ofrece SIN NINGUNA GARANTÍA; puedes redistribuirlo según las condiciones de la licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logiciel libre sous licence GNU GPL v3 ou ultérieure. Il est fourni SANS AUCUNE GARANTIE ; vous pouvez le redistribuer selon les conditions de la licence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU GPL v3 या उसके बाद के संस्करण के तहत मुक्त सॉफ़्टवेयर। यह बिना किसी वारंटी के आता है; आप लाइसेंस की शर्तों के अनुसार इसे पुनर्वितरित कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabad szoftver a GNU GPL v3 vagy újabb licenc alatt. ABSZOLÚT SEMMILYEN GARANCIÁT nem vállalunk rá; a licenc feltételei szerint továbbterjesztheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat lunak bebas di bawah GNU GPL v3 atau lebih baru. Disediakan TANPA JAMINAN APA PUN; Anda boleh mendistribusikannya ulang sesuai ketentuan lisensi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Software livre sob a GNU GPL v3 ou posterior. É fornecido SEM NENHUMA GARANTIA; você pode redistribuí-lo conforme as condições da licença."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободное ПО по лицензии GNU GPL v3 или более поздней. Предоставляется БЕЗ КАКИХ-ЛИБО ГАРАНТИЙ; вы можете распространять его на условиях лицензии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slobodný softvér pod licenciou GNU GPL v3 alebo novšou. Poskytuje sa ABSOLÚTNE BEZ ZÁRUKY; môžete ho ďalej šíriť za podmienok licencie."
          }
        }
      }
    },
    "GitHub could not be reached. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى GitHub. حاول مرة أخرى لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-এ পৌঁছানো যায়নি। পরে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ist nicht erreichbar. Versuche es später erneut."
          }
        },
        "es": {
